[Unit]
Description=Unify Desktop session (labwc)
Documentation=file:///usr/share/doc/unifyos/architecture.md
After=systemd-user-sessions.service NetworkManager.service
Wants=unify-sysmond.service
Conflicts=getty@tty1.service

[Service]
User=unify
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=Unify
Environment=XDG_SESSION_DESKTOP=unify
Environment=MOZ_ENABLE_WAYLAND=1
WorkingDirectory=/home/unify
ExecStart=/usr/bin/labwc-session
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical.target
