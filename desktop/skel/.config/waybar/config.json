{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 8,
  "margin-top": 0,
  "margin-left": 6,
  "margin-right": 6,
  "modules-left": ["custom/launcher", "wlr/workspaces", "wlr/taskbar"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "pulseaudio", "network", "cpu", "memory", "battery", "custom/power"],
  "custom/launcher": {
    "format": "Apps",
    "on-click": "fuzzel",
    "tooltip": false
  },
  "wlr/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-name": false
  },
  "wlr/taskbar": {
    "format": "{title}",
    "icon-size": 18,
    "icon-theme": "Papirus-Dark",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "on-click-right": "fullscreen"
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A %d %B %Y}",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<b><u>{}</u></b>"
      }
    }
  },
  "cpu": {
    "format": "CPU {usage}%",
    "interval": 3,
    "tooltip": false
  },
  "memory": {
    "format": "RAM {used:0.1f}G",
    "interval": 5,
    "tooltip": false
  },
  "network": {
    "format-wifi": "WiFi {essid}",
    "format-ethernet": "LAN {ifname}",
    "format-disconnected": "Offline",
    "tooltip-format": "{ifname} {ipaddr}/{cidr}",
    "on-click": "unify-ctl network status"
  },
  "pulseaudio": {
    "format": "Vol {volume}%",
    "format-muted": "Muted",
    "on-click": "pavucontrol",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },
  "battery": {
    "format": "BAT {capacity}%",
    "format-charging": "CHG {capacity}%",
    "format-plugged": "AC {capacity}%",
    "states": {
      "warning": 25,
      "critical": 10
    }
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "custom/power": {
    "format": "Power",
    "on-click": "unify-power-menu",
    "tooltip": false
  }
}
